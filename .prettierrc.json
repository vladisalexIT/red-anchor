{
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 100,
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-nunjucks"],
  "overrides": [
    {
      "files": ["*.njk", "*.nunjucks"],
      "options": {
        "parser": "nunjucks"
      }
    }
  ]
}
