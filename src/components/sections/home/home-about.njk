<section
  class="home-about"
  id="about"
  aria-labelledby="home-about-title"
>
  <div class="container home-about__container">
    <h2
      class="home-about__title"
      id="home-about-title"
    >
      <span class="home-about__number">
        2000
      </span>

      <span class="home-about__title-text">
        видов продукции
        в&nbsp;ассортименте
      </span>
    </h2>

    <div class="home-about__content">
      <a
        class="home-about__video"
        href="https://www.redanchor.ru/upload/uf/aa9/rzjx3c3ki2o5jmpq0tlcndr3fi1prof2/red_anchor_2025.mp4"
        target="_blank"
        rel="noopener"
        aria-label="Открыть видео о заводе в новой вкладке"
      >
        <picture class="home-about__picture">
          <source
            media="(min-width: 1920px)"
            srcset="/images/home/about/preview-1920.webp"
          >

          <source
            media="(min-width: 1600px)"
            srcset="/images/home/about/preview-1600.webp"
          >

          <source
            media="(min-width: 1366px)"
            srcset="/images/home/about/preview-1366.webp"
          >

          <source
            media="(min-width: 1024px)"
            srcset="/images/home/about/preview-1024.webp"
          >

          <source
            media="(min-width: 600px)"
            srcset="/images/home/about/preview-600.webp"
          >

          <img
            class="home-about__image"
            src="/images/home/about/preview-mobile.webp"
            alt=""
            loading="lazy"
            decoding="async"
          >
        </picture>

        <span
          class="home-about__play"
          aria-hidden="true"
        ></span>
      </a>

      <p class="home-about__description">
        «Завод Красный Якорь» располагает собственной
        производственной базой, оснащённой
        автоматическими линиями.
      </p>
    </div>
  </div>
</section>
