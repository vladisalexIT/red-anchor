{% from "components/sections/home/home-section-link.njk" import homeSectionLink %}

<section
  class="home-technologies"
  id="production"
  aria-labelledby="home-technologies-title"
>
  <div class="container home-technologies__container">
    <div class="home-technologies__content">
      <h2
        class="home-technologies__title"
        id="home-technologies-title"
      >
        Передовые технологии
      </h2>

      <ul class="home-technologies__list">
        <li class="home-technologies__item">
          <img
            class="home-technologies__icon"
            src="/images/home/icons/equipment.svg"
            width="80"
            height="80"
            alt=""
            loading="lazy"
            decoding="async"
          >

          <p class="home-technologies__item-title">
            Современное<br>
            оборудование
          </p>
        </li>

        <li class="home-technologies__item">
          <img
            class="home-technologies__icon"
            src="/images/home/icons/patents.svg"
            width="80"
            height="80"
            alt=""
            loading="lazy"
            decoding="async"
          >

          <p class="home-technologies__item-title">
            Запатентованные<br>
            разработки
          </p>
        </li>

        <li class="home-technologies__item">
          <img
            class="home-technologies__icon"
            src="/images/home/icons/forge.svg"
            width="80"
            height="80"
            alt=""
            loading="lazy"
            decoding="async"
          >

          <p class="home-technologies__item-title">
            С 2022 года работает<br>
            новая кузница
          </p>
        </li>

        <li class="home-technologies__item">
          <img
            class="home-technologies__icon"
            src="/images/home/icons/scanner.svg"
            width="80"
            height="80"
            alt=""
            loading="lazy"
            decoding="async"
          >

          <p class="home-technologies__item-title">
            3D-сканер<br>
            для проектирования
            и&nbsp;контроля качества
          </p>
        </li>
      </ul>

      {{ homeSectionLink("/production/", "О производстве") }}
    </div>
  </div>
</section>
