{% from "components/sections/home/home-section-link.njk" import homeSectionLink %}

<section
  class="home-quality"
  id="quality"
  aria-labelledby="home-quality-title"
>
  <div class="container home-quality__container">
    <h2
      class="home-quality__title"
      id="home-quality-title"
    >
      Проверки на&nbsp;всех уровнях
    </h2>

    <div class="home-quality__content">
      <ul class="home-quality__list">
        <li class="home-quality__item">
          <img
            class="home-quality__icon"
            src="/images/home/icons/laboratory.svg"
            width="80"
            height="80"
            alt=""
            loading="lazy"
            decoding="async"
          >

          <p class="home-quality__item-title">
            Собственная<br>
            сертифицированная<br>
            лаборатория
          </p>
        </li>

        <li class="home-quality__item">
          <img
            class="home-quality__icon"
            src="/images/home/icons/tests.svg"
            width="80"
            height="80"
            alt=""
            loading="lazy"
            decoding="async"
          >

          <p class="home-quality__item-title">
            Полный<br>
            комплекс<br>
            испытаний
          </p>
        </li>

        <li class="home-quality__item">
          <img
            class="home-quality__icon"
            src="/images/home/icons/requirements.svg"
            width="80"
            height="80"
            alt=""
            loading="lazy"
            decoding="async"
          >

          <p class="home-quality__item-title">
            Соответствие<br>
            требованиям<br>
            надзорных органов
          </p>
        </li>
      </ul>

      {{ homeSectionLink(
        "/laboratory/",
        "Как мы проводим испытания"
      ) }}
    </div>
  </div>
</section>
