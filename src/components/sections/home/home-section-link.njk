{% macro homeSectionLink(href, label) %}
  <a class="home-section-link" href="{{ href }}">
    <span class="home-section-link__text">
      {{ label }}
    </span>

    <svg
      class="home-section-link__icon"
      width="28"
      height="28"
      viewBox="0 0 28 28"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M6 6L22 22M9 22H22V9"
        stroke="currentColor"
        stroke-width="1.5"
      />
    </svg>
  </a>
{% endmacro %}
