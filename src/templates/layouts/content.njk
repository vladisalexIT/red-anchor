{% extends "templates/layouts/base.njk" %}
{% block content %}
  <article class='container content-page'>
    <nav aria-label='Хлебные крошки'>
      <a href='/'>Главная</a>
      /
      <span aria-current='page'>{{ page.title }}</span>
    </nav>
    <h1>{{ page.title }}</h1>
    <p class='content-page__intro'>{{ page.intro }}</p>
    {% if page.pending %}
      <p class='content-page__notice'>
        {{ page.pending }}
      </p>
    {% endif %}
    {% if page.cards.length %}
      <div class='content-page__grid'>
        {% for card in page.cards %}
          <section class='content-page__card'>
            <h2>{{ card.title }}</h2>
            <p>{{ card.text }}</p>
            <a href='{{ card.href }}'>Подробнее →</a>
          </section>
        {% endfor %}
      </div>
    {% endif %}
    {% block extra %}
    {% endblock %}
    <button
      class='content-page__cta'
      type='button'
      data-question-open
      aria-controls='question-dialog'
    >
      Задать вопрос →
    </button>
  </article>
{% endblock %}
