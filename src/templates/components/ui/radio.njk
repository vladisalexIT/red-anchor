{% macro radio(
    id,
    name,
    label,
    value,
    checked = false,
    disabled = false
  )
%}
  <label class='radio'>
    <input
      id='{{ id }}'
      class='radio__input'
      name='{{ name }}'
      type='radio'
      value='{{ value }}'
      {% if checked %}
        checked
      {% endif %}
      {% if disabled %}
        disabled
      {% endif %}
    />

    <span class='radio__circle' aria-hidden='true'></span>

    <span class='radio__text'>{{ label }}</span>
  </label>
{% endmacro %}
