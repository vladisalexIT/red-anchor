{% macro pagination(current = 1, total = 8) %}
  <nav class="pagination" aria-label="Навигация по страницам">
    {% for pageNumber in range(1, total + 1) %}
      <a
        class="pagination__link{% if pageNumber == current %} pagination__link--current{% endif %}"
        href="?page={{ pageNumber }}"
        {% if pageNumber == current %}aria-current="page"{% endif %}
      >
        {{ pageNumber }}
      </a>
    {% endfor %}
  </nav>
{% endmacro %}