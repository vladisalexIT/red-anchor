{% macro filter(
  action = "/catalog/",
  selectedCategory = ""
) %}
  <form
    class="filter"
    action="{{ action }}"
    method="get"
    data-filter
  >
    <div class="filter__header">
      <h2 class="filter__title">
        Фильтр
      </h2>

      <button class="filter__reset" type="reset">
        Сбросить
      </button>
    </div>

    <div class="filter__body">
      <div class="filter__group">
        <label class="filter__label" for="caliber-from">
          Калибр цепи
        </label>

        <div class="filter__range">
          <input
            class="filter__control"
            id="caliber-from"
            name="caliberFrom"
            type="number"
            min="11"
            max="120"
            placeholder="От"
            inputmode="numeric"
          >

          <span class="filter__range-separator" aria-hidden="true">
            —
          </span>

          <input
            class="filter__control"
            id="caliber-to"
            name="caliberTo"
            type="number"
            min="11"
            max="120"
            placeholder="До"
            inputmode="numeric"
          >
        </div>
      </div>

      <div class="filter__group">
        <label class="filter__label" for="chain-category">
          Категория цепи
        </label>

        <div class="filter__select-wrapper">
          <select
            class="filter__control filter__select"
            id="chain-category"
            name="category"
          >
            <option value="">Все категории</option>
            <option
              value="anchor-chains"
              {% if selectedCategory == "anchor-chains" %}selected{% endif %}
            >
              Якорные цепи
            </option>
            <option
              value="components"
              {% if selectedCategory == "components" %}selected{% endif %}
            >
              Комплектующие
            </option>
            <option
              value="accessories"
              {% if selectedCategory == "accessories" %}selected{% endif %}
            >
              Оснастка
            </option>
          </select>
        </div>
      </div>

      <button class="button button--primary filter__submit" type="submit">
        Применить фильтр
      </button>
    </div>
  </form>
{% endmacro %}