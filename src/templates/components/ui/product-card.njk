{% macro productCard(
  id,
  title,
  url = "#",
  category = "",
  unit = "",
  quantity = "",
  image = "",
  imageAlt = "",
  canOrder = true,
  categoryCode = "",
  caliber = ""
) %}
  <article
    class="product-card"
    data-product-card
    data-product-id="{{ id }}"
    data-product-category="{{ categoryCode }}"
    {% if caliber != "" %}
      data-product-caliber="{{ caliber }}"
    {% endif %}
  >
    <div class="product-card__media">
      {% if image %}
        <img
          class="product-card__image"
          src="{{ image }}"
          alt="{{ imageAlt or title }}"
          loading="lazy"
        >
      {% else %}
        <span
          class="product-card__media-placeholder"
          aria-hidden="true"
        >
          Изображение товара
        </span>
      {% endif %}
    </div>

    <div class="product-card__body">
      {% if category %}
        <p class="product-card__category">
          {{ category }}
        </p>
      {% endif %}

      <h3 class="product-card__title">
        <a
          class="product-card__title-link"
          href="{{ url }}"
        >
          {{ title }}
        </a>
      </h3>

      {% if unit or quantity %}
        <dl class="product-card__meta">
          {% if unit %}
            <div class="product-card__meta-row">
              <dt class="product-card__meta-label">
                Единица измерения
              </dt>

              <dd class="product-card__meta-value">
                {{ unit }}
              </dd>
            </div>
          {% endif %}

          {% if quantity %}
            <div class="product-card__meta-row">
              <dt class="product-card__meta-label">
                Минимальный заказ
              </dt>

              <dd class="product-card__meta-value">
                {{ quantity }}
              </dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

      <div class="product-card__actions">
        <a
          class="button button--secondary product-card__action"
          href="{{ url }}"
        >
          Подробнее
        </a>

        {% if canOrder %}
          <button
            class="button button--primary product-card__action"
            type="button"
            aria-pressed="false"
            data-add-to-order
            data-product-id="{{ id }}"
          >
            <span data-order-button-text>
              Добавить в заказ
            </span>
          </button>
        {% else %}
          <button
            class="button button--primary product-card__action"
            type="button"
            disabled
          >
            Недоступно
          </button>
        {% endif %}
      </div>
    </div>
  </article>
{% endmacro %}