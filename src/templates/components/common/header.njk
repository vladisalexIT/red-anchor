<header class="site-header" data-header>
  <div class="container site-header__container">
    <a
      class="site-header__logo"
      href="/"
      aria-label="{{ site.name }} — главная"
    >
      <span class="site-header__logo-text">
        {{ site.name }}
      </span>
    </a>

    <button
      class="site-header__menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      data-menu-toggle
    >
      <span class="site-header__menu-button-text">
        Меню
      </span>
    </button>

    <nav
      class="site-header__nav"
      id="main-navigation"
      aria-label="Основная навигация"
      data-menu
    >
      <ul class="site-header__nav-list">
        <li class="site-header__nav-item">
          <a class="site-header__nav-link" href="/">
            Главная
          </a>
        </li>

        <li class="site-header__nav-item">
          <a class="site-header__nav-link" href="/catalog/">
            Каталог
          </a>
        </li>

        <li class="site-header__nav-item">
          <a class="site-header__nav-link" href="/about/">
            О компании
          </a>
        </li>

        <li class="site-header__nav-item">
          <a class="site-header__nav-link" href="/contacts/">
            Контакты
          </a>
        </li>

        <li class="site-header__nav-item site-header__nav-item--action">
          <a class="button button--secondary" href="/contacts/">
            Стать поставщиком
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>