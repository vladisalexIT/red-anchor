{% from "templates/components/common/product-navigation.njk" import productNavigation %}

<header class="site-header" data-header>
  <div class="site-header__top">
    <div class="container site-header__top-inner">
      <a class="site-header__sitemap" href="/sitemap/">
        Карта сайта
      </a>

      <nav
        class="site-header__primary"
        aria-label="Основная навигация"
      >
        <ul class="site-header__top-navigation">
          <li>
            <a href="/industries/">Отрасли</a>
          </li>

          <li>
            <a href="/plant/">Завод</a>
          </li>

          <li>
            <a href="/production/">Производство</a>
          </li>

          <li>
            <a href="/services/">Услуги</a>
          </li>

          <li class="site-header__top-item--wide">
            <a href="/purchases/">Закупки</a>
          </li>

          <li class="site-header__top-item--wide">
            <a href="/career/">Карьера</a>
          </li>

          <li>
            <a href="/contacts/">Контакты</a>
          </li>

          <li class="site-header__top-item--compact">
            <details
              class="site-header__more"
              data-header-details
            >
              <summary>Ещё</summary>

              <ul class="site-header__more-menu">
                <li>
                  <a href="/purchases/">Закупки</a>
                </li>

                <li>
                  <a href="/career/">Карьера</a>
                </li>
              </ul>
            </details>
          </li>
        </ul>
      </nav>

      <div class="site-header__contacts">
        <a href="mailto:info@redanchor.ru">
          info@redanchor.ru
        </a>

        <a href="tel:+78312115511">
          +7 831 211-55-11
        </a>

        <button
          class="site-header__callback"
          type="button"
          aria-controls="callback-dialog"
          data-callback-open
        >
          Перезвоните мне
        </button>
      </div>
    </div>
  </div>

  <div class="container site-header__main">
    <a
      class="site-header__logo"
      href="/"
      aria-label="{{ site.name }} — главная"
    >
      <img
        src="/src/assets/images/logo.svg"
        width="154"
        height="48"
        alt=""
      >
    </a>

    <nav
      class="site-header__actions"
      aria-label="Навигация по продукции"
    >
      <details
        class="site-header__catalog"
        data-header-details
      >
        <summary class="site-header__action site-header__action--catalog">
          Продукция
        </summary>

        <div class="site-header__catalog-content">
          <div class="site-header__catalog-scroll">
            {{ productNavigation("header", false) }}
          </div>
        </div>
      </details>

      <form
        class="site-header__search"
        action="/catalog/"
        method="get"
        role="search"
      >
        <label class="visually-hidden" for="site-search">
          Поиск по каталогу
        </label>

        <input
          id="site-search"
          name="q"
          type="search"
          placeholder="Поиск по каталогу"
          autocomplete="off"
        >

        <button type="submit">
          Найти
        </button>
      </form>

      <a
        class="site-header__action"
        href="/buyers/"
      >
        Покупателю
      </a>

      <a
        class="site-header__action site-header__order"
        href="/order/"
      >
        Ваш заказ

        <span
          class="site-header__count"
          data-order-count
        >
          0
        </span>
      </a>
    </nav>

    <button
      class="site-header__menu-button"
      type="button"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="site-mobile-menu"
      data-menu-toggle
    >
      <span
        class="site-header__menu-icon"
        aria-hidden="true"
      ></span>
    </button>
  </div>

  <div
    class="site-header__mobile"
    id="site-mobile-menu"
    data-menu
    hidden
  >
    <div class="container site-header__mobile-inner">
      <form
        class="site-header__mobile-search"
        action="/catalog/"
        method="get"
        role="search"
      >
        <label
          class="visually-hidden"
          for="site-mobile-search"
        >
          Поиск по каталогу
        </label>

        <input
          id="site-mobile-search"
          name="q"
          type="search"
          placeholder="Поиск по каталогу"
          autocomplete="off"
        >

        <button type="submit">
          Найти
        </button>
      </form>

      <nav
        class="site-header__mobile-navigation"
        aria-label="Мобильная навигация"
      >
        <details
          class="site-header__mobile-catalog"
          data-header-details
        >
          <summary>
            Продукция
          </summary>

          <div class="site-header__mobile-submenu">
            {{ productNavigation("mobile", false) }}
          </div>
        </details>

        <a
          class="site-header__mobile-link"
          href="/buyers/"
        >
          Покупателю
        </a>

        <a
          class="site-header__mobile-link"
          href="/order/"
        >
          <span>Ваш заказ</span>

          <span
            class="site-header__mobile-count"
            data-order-count
          >
            0
          </span>
        </a>

        <a
          class="site-header__mobile-link"
          href="/industries/"
        >
          Отрасли
        </a>

        <a
          class="site-header__mobile-link"
          href="/plant/"
        >
          Завод
        </a>

        <a
          class="site-header__mobile-link"
          href="/production/"
        >
          Производство
        </a>

        <a
          class="site-header__mobile-link"
          href="/services/"
        >
          Услуги
        </a>

        <a
          class="site-header__mobile-link"
          href="/purchases/"
        >
          Закупки
        </a>

        <a
          class="site-header__mobile-link"
          href="/career/"
        >
          Карьера
        </a>

        <a
          class="site-header__mobile-link"
          href="/contacts/"
        >
          Контакты
        </a>
      </nav>

      <div class="site-header__mobile-contacts">
        <a href="mailto:info@redanchor.ru">
          info@redanchor.ru
        </a>

        <a href="tel:+78312115511">
          +7 831 211-55-11
        </a>

        <button
          class="site-header__callback"
          type="button"
          aria-controls="callback-dialog"
          data-callback-open
        >
          Перезвоните мне
        </button>
      </div>
    </div>
  </div>
</header>