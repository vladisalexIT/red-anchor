          },
          {
            title: "Стопоры цепные якорных устройств",
            href: "/catalog/?category=anchor-chainsstoppers/"
          },
          {
            title: "Цепи для оффшорных платформ",
            href: "/catalog/?category=anchor-chainsoffshore/"
          },
          {
            title: "Якоря",
            href: "/catalog/?category=anchor-chainsanchors/"
          },
          {
            title: "Цепи для крепления отбойных устройств причальных сооружений",
            href: "/catalog/?category=anchor-chainsfender-chains/"
          }
        ]
      },
      {
        title: "Цепи и комплектующие для горно-шахтного оборудования",
        href: "/catalog/?category=mining",
        code: "mining",
        items: [
          {
            title: "Цепи с овальными звеньями для крепления навесных цепей",
            href: "/catalog/?category=miningoval-link-chains/"
          },
          {
            title: "Цепи с кольцевыми звеньями",
            href: "/catalog/?category=mininground-link-chains/"
          },
          {
            title: "Комплектующие",
            href: "/catalog/?category=miningcomponents/"
          }
        ]
      },
      {
        title: "Грузоподъёмные цепи",
        href: "/catalog/?category=lifting",
        code: "lifting",
        items: [
          {
            title: "Цепи грузоподъёмные нормальной прочности. Класс 3",
            href: "/catalog/?category=liftingclass-3/"
          },
          {
            title: "Цепи грузоподъёмные. Класс прочности 8",
            href: "/catalog/?category=liftingclass-8/"
          },
          {
            title: "Цепи грузоподъёмные. Класс прочности 10",
            href: "/catalog/?category=liftingclass-10/"
          },
          {
            title: "Стропы грузоподъёмные",
            href: "/catalog/?category=liftingslings/"
          }
        ]
      },
      {
        title: "Цепи и комплектующие для цементной промышленности",
        href: "/catalog/?category=cement",
        code: "cement",
        items: [
          {
            title: "Цепи для цементной промышленности",
            href: "/catalog/?category=cementchains/"
          },
          {
            title: "Комплектующие",
            href: "/catalog/?category=cementcomponents/"
          }
        ]
      },
      {
        title: "Цепи общего назначения",
        href: "/catalog/?category=general-purpose",
        code: "general-purpose",
        items: [
          {
            title: "Цепи нормальной прочности короткозвенные. Класс 2,5",
            href: "/catalog/?category=general-purposeshort-link/"
          },
          {
            title: "Цепи нормальной прочности длиннозвенные. Класс 2",
            href: "/catalog/?category=general-purposelong-link/"
          },
          {
            title: "Цепи для авиационной промышленности",
            href: "/catalog/?category=general-purposeaviation/"
          },
          {
            title: "Устройства для крепления при перевозке грузов",
            href: "/catalog/?category=general-purposecargo-fastening/"
          },
          {
            title: "Цепи для изготовления многооборотных систем крепления",
            href: "/catalog/?category=general-purposereusable-fastening/"
          },
          {
            title: "Цепи для конвейеров и транспортёров",
            href: "/catalog/?category=general-purposeconveyors/"
          },
          {
            title: "Цепи по DIN 763",
            href: "/catalog/?category=general-purposedin-763/"
          },
          {
            title: "Цепи для рыболовной промышленности",
            href: "/catalog/?category=general-purposefishing/"
          }
        ]
      },
      {
        title: "Несерийная продукция",
        href: "/catalog/?category=nonstandard",
        code: "nonstandard",
        items: [
          {
            title: "Оборудование для монтажа и демонтажа цепей и скребков",
            href: "/catalog/?category=nonstandardinstallation-equipment/"
          },
          {
            title: "Цепи шинозащитные",
            href: "/catalog/?category=nonstandardtire-protection/"
          },
          {
            title: "Цепи противоскольжения",
            href: "/catalog/?category=nonstandardanti-skid/"
          },
          {
            title: "Заклёпки HUCK и метизы",
            href: "/catalog/?category=nonstandardfasteners/"
          }
        ]
      }
    ]
  %}

  <div
    class='
      product-navigation
      {% if modifier %}
        product-navigation--{{ modifier }}
      {% endif %}
    '
    data-product-navigation
  >
    <ul class='product-navigation__groups'>
      {% for group in groups %}
        <li class='product-navigation__group' data-product-navigation-group='{{ group.code }}'>
          <a class='product-navigation__group-link' href='{{ group.href }}'>
            <span>{{ group.title }}</span>

            <span class='product-navigation__arrow' aria-hidden='true'>→</span>
          </a>

          {% if showChildren %}
            <ul class='product-navigation__children'>
              {% for item in group.items %}
                <li class='product-navigation__child'>
                  <a class='product-navigation__child-link' href='{{ item.href }}'>
                    {{ item.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endmacro %}
