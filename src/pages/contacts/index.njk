    <nav aria-label='Хлебные крошки'>
      <a href='/'>Главная</a>
      / Контакты
    </nav>
    <h1>Контакты</h1>
    <div class='content-page__grid'>
      <section class='content-page__card'>
        <h2>Отдел продаж</h2>
        <a href='tel:+78312115511'>+7 831 211-55-11</a>
        <a href='mailto:sales@redanchor.ru'>sales@redanchor.ru</a>
