{% extends "templates/layouts/base.njk" %}
{% set pageTitle = "UI-kit — Красный якорь" %}
{% from "templates/components/ui/button.njk" import button %}
{% from "templates/components/ui/checkbox.njk" import checkbox %}
{% from "templates/components/ui/radio.njk" import radio %}
{% from "templates/components/ui/badge.njk" import badge %}
{% from "templates/components/ui/date-field.njk" import dateField %}
{% from "templates/components/ui/file-upload.njk" import fileUpload %}
{% from "templates/components/ui/input.njk" import input %}
{% from "templates/components/ui/select.njk" import select %}
{% from "templates/components/ui/textarea.njk" import textarea %}
{% from "templates/components/ui/breadcrumb.njk" import breadcrumb %}
{% from "templates/components/ui/pagination.njk" import pagination %}
{% from "templates/components/common/help-cta.njk" import helpCta %}
{% from "templates/components/common/notice.njk" import notice %}
{% from "templates/components/common/product-navigation.njk" import productNavigation %}
{% from "templates/components/common/nonstandard-request-form.njk" import nonstandardRequestForm %}
{% from "templates/components/product/document-list.njk" import documentList %}
{% from "templates/components/common/process-steps.njk" import processSteps %}
{% from "templates/components/content/article-list.njk" import articleList %}

{% macro typeSample(label, className, text) %}
  <article class="ui-kit__type-sample">
    <p class="ui-kit__type-label">{{ label }}</p>
    <p class="{{ className }}">{{ text }}</p>
  </article>
{% endmacro %}

{% set paragraphText %}
  Формирование имиджа создаёт межличностный баинг и селлинг.
  Согласно ставшей уже классической работе Филипа Котлера,
  организация практического взаимодействия директивно
  специфицирует конвергентный диктат потребителя.
{% endset %}

{% set shortText %}
  Для короткого текста, состоящего из 1–3 строчек.
  Формирование имиджа создаёт.
{% endset %}

{% block content %}
  <section class="ui-kit">
    <div class="container">
      <header class="ui-kit__header">
        <p class="ui-kit__label">Служебная страница</p>

        <h1 class="type-h1">
          UI-kit проекта
        </h1>

        <p class="type-p2">
          Типографические стили, цвета, кнопки, поля форм,
          карточки и остальные повторяемые компоненты проекта.
        </p>
      </header>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Заголовки
        </h2>

        <div class="ui-kit__preview">
          {{ typeSample(
            "H1 большой · TT Bluescreens Bold 700",
            "type-display",
            "Большой заголовок первого уровня"
          ) }}

          {{ typeSample(
            "H1 средний · TT Bluescreens Bold 700",
            "type-h1",
            "Заголовок первого уровня"
          ) }}

          {{ typeSample(
            "H2 · TT Bluescreens Bold 700",
            "type-h2",
            "Заголовок второго уровня"
          ) }}

          {{ typeSample(
            "H3 · TT Bluescreens Bold 700",
            "type-h3",
            "Заголовок третьего уровня"
          ) }}

          {{ typeSample(
            "H4 · TT Bluescreens Bold 700",
            "type-h4",
            "Заголовок четвёртого уровня"
          ) }}

          {{ typeSample(
            "H5 · TT Bluescreens Bold 700",
            "type-h5",
            "Заголовок пятого уровня"
          ) }}
        </div>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Основной текст
        </h2>

        <div class="ui-kit__preview">
          {{ typeSample(
            "P1 Light · PF DIN Text Cond Pro 300",
            "type-p1",
            paragraphText
          ) }}

          {{ typeSample(
            "P1 Medium · PF DIN Text Cond Pro 500",
            "type-p1 type--medium",
            paragraphText
          ) }}

          {{ typeSample(
            "P2 Light · PF DIN Text Cond Pro 300",
            "type-p2",
            paragraphText
          ) }}

          {{ typeSample(
            "P2 Medium · PF DIN Text Cond Pro 500",
            "type-p2 type--medium",
            paragraphText
          ) }}

          {{ typeSample(
            "P3 Light · PF DIN Text Cond Pro 300",
            "type-p3",
            paragraphText
          ) }}

          {{ typeSample(
            "P3 Medium · PF DIN Text Cond Pro 500",
            "type-p3 type--medium",
            paragraphText
          ) }}

          {{ typeSample(
            "P4 Light · PF DIN Text Cond Pro 300",
            "type-p4",
            paragraphText
          ) }}

          {{ typeSample(
            "P4 Medium · PF DIN Text Cond Pro 500",
            "type-p4 type--medium",
            paragraphText
          ) }}
        </div>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Короткий текст
        </h2>

        <div class="ui-kit__preview ui-kit__preview--short">
          {{ typeSample(
            "S1 Light · PF DIN Text Cond Pro 300",
            "type-s1",
            shortText
          ) }}

          {{ typeSample(
            "S1 Medium · PF DIN Text Cond Pro 500",
            "type-s1 type--medium",
            shortText
          ) }}

          {{ typeSample(
            "S2 Light · PF DIN Text Cond Pro 300",
            "type-s2",
            shortText
          ) }}

          {{ typeSample(
            "S2 Medium · PF DIN Text Cond Pro 500",
            "type-s2 type--medium",
            shortText
          ) }}

          {{ typeSample(
            "S3 Light · PF DIN Text Cond Pro 300",
            "type-s3",
            shortText
          ) }}

          {{ typeSample(
            "S3 Medium · PF DIN Text Cond Pro 500",
            "type-s3 type--medium",
            shortText
          ) }}

          {{ typeSample(
            "S4 Light · PF DIN Text Cond Pro 300",
            "type-s4",
            shortText
          ) }}

          {{ typeSample(
            "S4 Medium · PF DIN Text Cond Pro 500",
            "type-s4 type--medium",
            shortText
          ) }}
        </div>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Кнопки
        </h2>

        <div class="ui-kit__row">
          {{ button("Основная кнопка", "#") }}
          {{ button("Вторичная кнопка", "#", "secondary") }}
        </div>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Поля формы
        </h2>

        <div class="ui-kit__form-preview">
          {{ input(
            "Ваше ФИО",
            "demo-name",
            "name",
            "text",
            "Иванов Иван Иванович",
            "",
            true
          ) }}

          {{ input(
            "Желаемый срок",
            "demo-date",
            "date",
            "date",
            "",
            "",
            true
          ) }}

          {{ select(
            "Материал",
            "demo-material",
            "material",
            [
              { value: "", label: "Выберите материал" },
              { value: "category-1", label: "Категория 1" },
              { value: "category-2", label: "Категория 2" },
              { value: "category-3", label: "Категория 3" },
              { value: "category-4", label: "Категория 4" }
            ]
          ) }}

          {{ textarea(
            "Ваш комментарий",
            "demo-comment",
            "comment",
            "Текст комментария"
          ) }}
        </div>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Хлебные крошки
        </h2>

        {{ breadcrumb([
          { label: "Продукция", href: "/catalog/" },
          { label: "Якорные цепи и комплектующие", href: "#" },
          { label: "Якорные смычки", current: true }
        ]) }}
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Пагинация
        </h2>

        {{ pagination(3, 8) }}
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Дата
        </h2>

        <div class="ui-kit__form-preview">
          {{ dateField(
            "Желаемая дата поставки",
            "demo-delivery-date",
            "deliveryDate",
            "",
            true
          ) }}
        </div>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Checkbox и radio
        </h2>

        <div class="ui-kit__component-group">
          {{ checkbox(
            "demo-agreement",
            "agreement",
            "Я согласен на обработку данных",
            "yes",
            true
          ) }}

          {{ checkbox(
            "demo-disabled-checkbox",
            "disabledAgreement",
            "Недоступный checkbox",
            "disabled",
            false,
            true
          ) }}
        </div>

        <div class="ui-kit__component-group">
          {{ radio(
            "demo-delivery-warehouse",
            "deliveryType",
            "Доставка на склад",
            "warehouse",
            true
          ) }}

          {{ radio(
            "demo-delivery-address",
            "deliveryType",
            "Доставка по адресу",
            "address"
          ) }}

          {{ radio(
            "demo-disabled-radio",
            "disabledDeliveryType",
            "Недоступный radio",
            "disabled",
            false,
            true
          ) }}
        </div>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Badge
        </h2>

        <div class="ui-kit__component-group">
          {{ badge("Каталог") }}
          {{ badge("Новинка", "accent") }}
          {{ badge("Архив", "dark") }}
          {{ badge("Подробнее", "outline") }}
          {{ badge("Служебный", "muted") }}
        </div>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Загрузка файла
        </h2>

        <div class="ui-kit__file-preview">
          {{ fileUpload(
            "demo-attachment",
            "attachment"
          ) }}
        </div>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Помощь с подбором продукции
        </h2>

        {{ helpCta("ui-kit-help") }}
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Предупреждение
        </h2>

        {{ notice(
          "Внимание",
          "Для обеспечения длительного срока безаварийной эксплуатации, предотвращения деформации и поломки элементов якорной цепи и якорно-швартового устройства необходимо следить, чтобы нагрузка на изделия прилагалась исключительно по линии каната, в соответствии с направлением, при котором производятся испытания элементов изделия.",
          "Приложение нагрузки под углом к длине каната приводит к выходу изделия из строя."
        ) }}
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Навигация по продукции
        </h2>

        <nav aria-label="Демонстрация категорий продукции">
          {{ productNavigation("catalog", true) }}
        </nav>
      </section>

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Форма нестандартного заказа
        </h2>

        {{ nonstandardRequestForm("ui-kit-nonstandard-request") }}
      </section>

      {% set demoDocuments = [
        {
          title: "Пример технического документа № 1",
          description: "Документ без ссылки используется только для проверки интерфейса",
          format: "PDF",
          size: "6,3 МБ"
        },
        {
          title: "Пример технического документа № 2",
          format: "PDF",
          size: "2,1 МБ"
        },
        {
          title: "Пример технического документа № 3",
          format: "DOCX",
          size: "840 КБ"
        },
        {
          title: "Пример технического документа № 4",
          format: "XLSX",
          size: "310 КБ"
        },
        {
          title: "Пример технического документа № 5",
          format: "PDF",
          size: "4,8 МБ"
        },
        {
          title: "Пример технического документа № 6",
          format: "PDF",
          size: "1,4 МБ"
        },
        {
          title: "Пример технического документа № 7",
          format: "PDF",
          size: "970 КБ"
        },
        {
          title: "Пример технического документа № 8",
          format: "PDF",
          size: "3,2 МБ"
        }
      ] %}

      <section class="ui-kit__section">
        <h2 class="type-h4 ui-kit__section-title">
          Документы и запрос ТУ
        </h2>

        {{ documentList(
          "ui-kit-documents",
          demoDocuments,
          4
        ) }}
      </section>

      {% set demoProcessSteps = [
        {
          title: "Отправьте заявку",
          text: "Выберите продукцию в каталоге или опишите задачу для индивидуального изготовления.",
          href: "/request/#nonstandard-request",
          linkText: "Оставить заявку"
        },
        {
          title: "Уточните требования",
          text: "Специалист свяжется с вами, проверит характеристики, количество и условия эксплуатации."
        },
        {
          title: "Получите предложение",
          text: "Мы согласуем технические параметры, стоимость, срок изготовления и условия поставки."
        },
        {
          title: "Получите продукцию",
          text: "Заказ передаётся самовывозом либо доставляется до согласованного склада или терминала."
        }
      ] %}

      <section class="ui-kit__section">
        {{ processSteps(
          "ui-kit-process",
          demoProcessSteps,
          "Как мы работаем",
          "Порядок работы",
          "Путь от первичной заявки до получения готовой продукции."
        ) }}
      </section>

      <section class="ui-kit__section">
        {{ processSteps(
          "ui-kit-process-dark",
          demoProcessSteps,
          "Как приобрести продукцию",
          "Поставка и заказ",
          "",
          "dark"
        ) }}
      </section>

      {% set demoArticles = [
        {
          category: "Эксплуатация",
          date: "Материал",
          title: "Как подобрать калибр цепи для условий эксплуатации",
          description: "Общие критерии, которые необходимо учитывать перед направлением технического задания."
        },
        {
          category: "Продукция",
          date: "Материал",
          title: "Комплектующие якорных цепей и их назначение",
          description: "Основные виды комплектующих и особенности формирования готового якорного каната."
        },
        {
          category: "Поставка",
          date: "Материал",
          title: "Какие данные нужны для расчёта заказа",
          description: "Перечень исходной информации, ускоряющей согласование технических параметров продукции."
        }
      ] %}

      <section class="ui-kit__section">
        {{ articleList(
          "ui-kit-articles",
          demoArticles,
          "Полезные статьи",
          "Материалы",
          "Информация о подборе, эксплуатации и заказе цепной продукции."
        ) }}
      </section>
    </div>
  </section>
{% endblock %}
