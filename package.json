{
  "name": "red-anchor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:scripts": "eslint src --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint": "npm run lint:scripts && npm run lint:styles",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,scss,md}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vituum/vite-plugin-nunjucks": "^2.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vituum": "^2.0.2"
  }
}
